<?xml version="1.0"?>
<sdf version="1.9">
  <world name="slip_test">

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ==================== bump field: uneven-terrain event testing ==================== -->
    <!-- heightmap image is grayscale, white = high, black = low. size/pos in meters -->
    <model name="bump_field">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <heightmap>
              <uri>file://bump_field.png</uri>
              <size>4 4 0.08</size>
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.9</mu><mu2>0.9</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <heightmap>
              <uri>file://bump_field.png</uri>
              <size>4 4 0.08</size>
              <pos>0 0 0</pos>
              <texture>
                <diffuse>1.0 1.0 1.0</diffuse>
                <size>1</size>
              </texture>
            </heightmap>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- ==================== slip zone: low-friction patch for slip event testing ==================== -->
    <!-- placed past the bump field, mu well below the ground default to trigger wheel slip -->
    <model name="slip_zone">
      <static>true</static>
      <pose>3 0 0.001 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 2.0 0.002</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>0.05</mu><mu2>0.05</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 2.0 0.002</size></box></geometry>
          <material>
            <ambient>0.1 0.3 0.8 0.6</ambient>
            <diffuse>0.1 0.3 0.8 0.6</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- flat ground plane surrounding the terrain features -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface>
            <friction>
              <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
